TZ=Europe/Paris

HA_DOMAIN=
LE_EMAIL=

POSTGRES_DB=homeassistant
POSTGRES_USER=ha
POSTGRES_PASSWORD=

# Profils Docker Compose actifs, lus automatiquement par `docker compose`
# quand les commandes sont lancées depuis /srv/ha-stack (fichier .env du
# répertoire projet). Garantit que `docker compose restart|up -d|down`
# tapés à la main ciblent bien Caddy (+ Zigbee2MQTT le cas échéant), sans
# avoir à repasser --profile. L'installeur écrit/maj cette valeur selon les
# choix du wizard. Valeurs possibles : "caddy" ou "caddy,zigbee2mqtt".
COMPOSE_PROFILES=caddy
